# Federation Hub settings. Safe to commit: no secrets here.
# Passwords live in secrets.env, which setup.sh creates for you.

# The hub's own certificate authority. It signs the hub's server certificate
# and the admin certificate for the web interface.
CA_NAME=TAK-STACK-HUB-CA
COUNTRY=CA
STATE=AB
CITY=Calgary
ORGANIZATION=TAKStack-Hub
ORGANIZATIONAL_UNIT=Lab
