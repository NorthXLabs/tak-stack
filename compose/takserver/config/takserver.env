# TAK Server settings. Safe to commit: no secrets here.
# Passwords live in secrets.env, which setup.sh creates for you.

# Certificate authority: who issues your certificates. CA_NAME names the root
# CA. To replace the root, give it a new name and run ./rotate-ca.sh root.
CA_NAME=TAK-STACK-CA
COUNTRY=CA
STATE=AB
CITY=Calgary
ORGANIZATION=TAKStack
ORGANIZATIONAL_UNIT=Lab

# Every address that devices use to reach this server: IP addresses and
# hostnames, separated by spaces. The server's certificate must name each one,
# or devices refuse to enroll. Change this and restart to update the certificate.
SERVER_ADDRESSES=localhost

# The admin certificate, used to manage the server from a browser.
ADMIN_CERT_NAME=admin

# Users who connect by enrolling: they sign in with a username and password,
# and the server issues their certificate. setup.sh creates their passwords.
USERS=alpha-1 bravo-1

# Optional: certificates made in advance on the server, for devices that can't
# enroll and for services such as data feeds. Names don't need to be in USERS.
# Each gets a .p12 protected by CLIENT_CERT_PASS. Removing a name doesn't
# revoke its certificate: use REVOKE for that.
CLIENT_CERTS=

# Optional: groups. Through the server, devices only share with devices in a
# group they have in common. Format: name:group, or name:group1,group2 for
# several. Names with no groups share in the default group, __ANON__.
# Example: USER_GROUPS=alpha-1:blue bravo-1:blue charlie-1:red
USER_GROUPS=

# Names to lock out, separated by spaces. Each start revokes every certificate
# the server issued them, revokes any certificate made in advance, and deletes
# the user, so they can't enroll again.
REVOKE=
